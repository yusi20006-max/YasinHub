#!/data/data/com.termux/files/usr/bin/bash
# runit/termux-services supervised entry for Yasin-Agent HTTP runtime.
# Canonical layout: ~/yasineco/Yasin-agent
# Supervisor owns this process; YasinHub must not spawn a second instance.
set -euo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export PATH="${PREFIX}/bin:${PATH:-}"

AGENT_ROOT="${YASIN_AGENT_ROOT:-${HOME}/yasineco/Yasin-agent}"
cd "${AGENT_ROOT}"

# Canonical shared-token contract: file ALWAYS wins over stale environment.
# Never echo the token value.
TOKEN_FILE="${HOME}/.yasinhub/yasin-agent.token"
if [ -f "${TOKEN_FILE}" ]; then
  # shellcheck disable=SC2002
  FILE_TOKEN="$(cat "${TOKEN_FILE}" | tr -d '\n\r')"
  if [ -n "${FILE_TOKEN}" ]; then
    export YASIN_AGENT_SERVICE_TOKEN="${FILE_TOKEN}"
  fi
fi
if [ -z "${YASIN_AGENT_SERVICE_TOKEN:-}" ]; then
  echo "yasin-agent run: token missing (expected ${TOKEN_FILE})" >&2
  exit 1
fi

export YASIN_AGENT_HOST="${YASIN_AGENT_HOST:-127.0.0.1}"
export YASIN_AGENT_PORT="${YASIN_AGENT_PORT:-8080}"

# Refuse to start a second listener if something already holds the port.
if command -v ss >/dev/null 2>&1; then
  if ss -ltn 2>/dev/null | grep -qE ":${YASIN_AGENT_PORT}\b"; then
    echo "yasin-agent run: port ${YASIN_AGENT_PORT} already in use \u2014 refuse duplicate start" >&2
    exit 1
  fi
elif command -v netstat >/dev/null 2>&1; then
  if netstat -ltn 2>/dev/null | grep -qE ":${YASIN_AGENT_PORT}\b"; then
    echo "yasin-agent run: port ${YASIN_AGENT_PORT} already in use \u2014 refuse duplicate start" >&2
    exit 1
  fi
fi

if [ -x "${AGENT_ROOT}/.venv/bin/python" ]; then
  PYTHON="${AGENT_ROOT}/.venv/bin/python"
else
  PYTHON="${PREFIX}/bin/python3"
fi

export PYTHONPATH="${AGENT_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"

exec "${PYTHON}" -m agent_platform.server
