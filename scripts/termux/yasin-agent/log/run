#!/data/data/com.termux/files/usr/bin/bash
# Multilog for yasin-agent under termux-services/runit.
set -euo pipefail
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export PATH="${PREFIX}/bin:${PATH:-}"
LOG_DIR="${HOME}/.yasinhub/logs/yasin-agent"
mkdir -p "${LOG_DIR}"
exec multilog t s1048576 n10 "${LOG_DIR}"
